[gd_resource type="Resource" script_class="CommsMessage" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/components/comms_message.gd" id="1_msg"]

[resource]
script = ExtResource("1_msg")
id = &"msg_control_ack"
sender = "MISSION CONTROL"
date_text = "DAY 0001 06:00"
body = "Scheduled wake notice from the preloaded Mission Control protocol. Activation report accepted into the shipboard outbound queue. This is a local receipt generated when the report was queued; no return transmission has arrived.

Signal time to Control is measured in weeks. Continue scheduled maintenance and log by shift.

MISSION CONTROL"
direction = &"in"
arrival_day = 1
