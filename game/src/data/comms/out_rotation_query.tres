[gd_resource type="Resource" script_class="CommsMessage" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/components/comms_message.gd" id="1_msg"]

[resource]
script = ExtResource("1_msg")
id = &"out_rotation_query"
sender = "OPERATOR"
body = "OPERATOR ROTATION QUERY
Requesting rotation status and relief window. Current tour has passed the scheduled handover point.

Advise expected relief date and any change to the manifest."
direction = &"out"
reply_id = &"msg_reply_rotation"
reply_delay_days = 8.0
