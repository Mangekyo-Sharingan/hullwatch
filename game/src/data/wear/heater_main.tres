[gd_resource type="Resource" script_class="WearComponent" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_heater_open"]
script = ExtResource("2")
id = &"heater_open"
display_name = "Heater Open Circuit"
base_mtbf_hours = 2500.0
wear_multiplier = 1.0
max_condition = 1.0
environmental_factors = {
"load": 2.0
}
severity = 2
symptoms = Array[StringName]([&"no_heat", &"cold_cabin"])

[sub_resource type="Resource" id="FailureMode_sensor_drift"]
script = ExtResource("2")
id = &"sensor_drift"
display_name = "Thermostat Sensor Drift"
base_mtbf_hours = 3000.0
wear_multiplier = 1.0
max_condition = 1.0
environmental_factors = {
"load": 2.0
}
severity = 1
symptoms = Array[StringName]([&"cold_cabin", &"target_offset"])

[resource]
script = ExtResource("1")
component_id = &"heater_main"
display_name = "Cabin Heater"
condition = 1.0
hours_operated = 0.0
wear_rate_per_hour = 0.00015
load = 1.0
failure_modes = Array[FailureMode]([SubResource("FailureMode_heater_open"), SubResource("FailureMode_sensor_drift")])
