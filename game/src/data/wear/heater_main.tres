[gd_resource type="Resource" script_class="WearComponent" format=3 uid="uid://4ybvfxp2id4d"]

[ext_resource type="Script" uid="uid://ng7r2qk1dktu" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" uid="uid://ccebuvaam2wn4" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_heater_open"]
script = ExtResource("2")
id = &"heater_open"
display_name = "Heater Open Circuit"
base_mtbf_hours = 2500.0
environmental_factors = {
"load": 2.0
}
severity = 2
symptoms = Array[StringName]([&"no_heat", &"cold_cabin"])

[sub_resource type="Resource" id="FailureMode_sensor_drift"]
script = ExtResource("2")
id = &"sensor_drift"
display_name = "Thermostat Sensor Drift"
base_mtbf_hours = 3000.0
environmental_factors = {
"load": 2.0
}
symptoms = Array[StringName]([&"cold_cabin", &"target_offset"])

[resource]
resource_local_to_scene = true
script = ExtResource("1")
component_id = &"heater_main"
display_name = "Cabin Heater"
wear_rate_per_hour = 0.00015
failure_modes = Array[ExtResource("2")]([SubResource("FailureMode_heater_open"), SubResource("FailureMode_sensor_drift")])

service_circuit = &"life_support"
service_part = &"gasket"
service_hours = 0.25
service_quality = 0.75
