[gd_resource type="Resource" script_class="WearComponent" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_plating_fatigue"]
script = ExtResource("2")
id = &"plating_fatigue"
display_name = "Plating Fatigue"
base_mtbf_hours = 5000.0
wear_multiplier = 1.0
max_condition = 1.0
severity = 2
symptoms = Array[StringName]([&"micro_leaks", &"hull_groan"])

[sub_resource type="Resource" id="FailureMode_seam_split"]
script = ExtResource("2")
id = &"seam_split"
display_name = "Seam Split"
base_mtbf_hours = 7000.0
wear_multiplier = 1.0
max_condition = 1.0
severity = 3
symptoms = Array[StringName]([&"pressure_loss", &"hull_creak"])

[resource]
script = ExtResource("1")
component_id = &"hull_plating_main"
display_name = "Hull Plating"
condition = 1.0
hours_operated = 0.0
wear_rate_per_hour = 0.00005
load = 1.0
failure_modes = Array[FailureMode]([SubResource("FailureMode_plating_fatigue"), SubResource("FailureMode_seam_split")])
