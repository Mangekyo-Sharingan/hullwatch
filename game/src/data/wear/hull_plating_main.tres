[gd_resource type="Resource" script_class="WearComponent" format=3 uid="uid://f5kstsxqnp1y"]

[ext_resource type="Script" uid="uid://ng7r2qk1dktu" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" uid="uid://ccebuvaam2wn4" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_plating_fatigue"]
script = ExtResource("2")
id = &"plating_fatigue"
display_name = "Plating Fatigue"
base_mtbf_hours = 5000.0
severity = 2
symptoms = Array[StringName]([&"micro_leaks", &"hull_groan"])

[sub_resource type="Resource" id="FailureMode_seam_split"]
script = ExtResource("2")
id = &"seam_split"
display_name = "Seam Split"
base_mtbf_hours = 7000.0
severity = 3
symptoms = Array[StringName]([&"pressure_loss", &"hull_creak"])

[resource]
script = ExtResource("1")
component_id = &"hull_plating_main"
display_name = "Hull Plating"
wear_rate_per_hour = 5e-05
failure_modes = Array[ExtResource("2")]([SubResource("FailureMode_plating_fatigue"), SubResource("FailureMode_seam_split")])
