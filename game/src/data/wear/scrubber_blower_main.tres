[gd_resource type="Resource" script_class="WearComponent" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_bearing_whine"]
script = ExtResource("2")
id = &"bearing_whine"
display_name = "Bearing Whine"
base_mtbf_hours = 4000.0
wear_multiplier = 1.0
max_condition = 1.0
environmental_factors = {
"load": 2.5
}
severity = 1
symptoms = Array[StringName]([&"audible_whine", &"vibration_buzz"])

[sub_resource type="Resource" id="FailureMode_blower_seize"]
script = ExtResource("2")
id = &"blower_seize"
display_name = "Blower Seize"
base_mtbf_hours = 5000.0
wear_multiplier = 1.0
max_condition = 1.0
environmental_factors = {
"load": 2.5
}
severity = 3
symptoms = Array[StringName]([&"fan_stopped", &"co2_rise"])

[resource]
script = ExtResource("1")
component_id = &"scrubber_blower_main"
display_name = "Scrubber Blower"
condition = 1.0
hours_operated = 0.0
wear_rate_per_hour = 0.0001
load = 1.0
failure_modes = Array[FailureMode]([SubResource("FailureMode_bearing_whine"), SubResource("FailureMode_blower_seize")])
