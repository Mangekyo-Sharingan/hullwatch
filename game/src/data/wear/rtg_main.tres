[gd_resource type="Resource" script_class="WearComponent" format=3 uid="uid://dlvlx7ljps4dv"]

[ext_resource type="Script" uid="uid://ng7r2qk1dktu" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" uid="uid://ccebuvaam2wn4" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_rtg_degraded"]
script = ExtResource("2")
id = &"rtg_degraded"
display_name = "RTG Degraded"
base_mtbf_hours = 3200.0
environmental_factors = {
"heat": 3.0,
"humidity": 2.0
}
severity = 2
symptoms = Array[StringName]([&"voltage_sag", &"thermal_whine"])

[sub_resource type="Resource" id="FailureMode_rtg_open_circuit"]
script = ExtResource("2")
id = &"rtg_open_circuit"
display_name = "RTG Open Circuit"
base_mtbf_hours = 2400.0
environmental_factors = {
"heat": 3.0,
"humidity": 2.0
}
severity = 3
symptoms = Array[StringName]([&"no_output", &"cold_casing"])

[resource]
resource_local_to_scene = true
script = ExtResource("1")
component_id = &"rtg_main"
display_name = "Main RTG"
wear_rate_per_hour = 0.0002
failure_modes = Array[ExtResource("2")]([SubResource("FailureMode_rtg_degraded"), SubResource("FailureMode_rtg_open_circuit")])

service_circuit = &"all_bus"
service_part = &"gasket"
service_hours = 0.25
service_quality = 0.75
