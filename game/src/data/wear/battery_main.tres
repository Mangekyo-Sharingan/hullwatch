[gd_resource type="Resource" script_class="WearComponent" format=3 uid="uid://bs2njn1xjhugn"]

[ext_resource type="Script" uid="uid://ng7r2qk1dktu" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" uid="uid://ccebuvaam2wn4" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_cell_fade"]
script = ExtResource("2")
id = &"cell_fade"
display_name = "Cell Fade"
base_mtbf_hours = 3000.0
environmental_factors = {
"heat": 2.5,
"humidity": 1.5
}
symptoms = Array[StringName]([&"reduced_runtime", &"slow_charge"])

[sub_resource type="Resource" id="FailureMode_cell_short"]
script = ExtResource("2")
id = &"cell_short"
display_name = "Cell Short"
base_mtbf_hours = 2600.0
environmental_factors = {
"heat": 2.5,
"humidity": 1.5
}
severity = 3
symptoms = Array[StringName]([&"self_discharge", &"hot_cell"])

[resource]
script = ExtResource("1")
component_id = &"battery_main"
display_name = "Main Battery"
wear_rate_per_hour = 0.0002
failure_modes = Array[ExtResource("2")]([SubResource("FailureMode_cell_fade"), SubResource("FailureMode_cell_short")])
