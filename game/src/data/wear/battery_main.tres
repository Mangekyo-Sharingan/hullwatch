[gd_resource type="Resource" script_class="WearComponent" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_cell_fade"]
script = ExtResource("2")
id = &"cell_fade"
display_name = "Cell Fade"
base_mtbf_hours = 3000.0
wear_multiplier = 1.0
max_condition = 1.0
environmental_factors = {
"heat": 2.5,
"humidity": 1.5
}
severity = 1
symptoms = Array[StringName]([&"reduced_runtime", &"slow_charge"])

[sub_resource type="Resource" id="FailureMode_cell_short"]
script = ExtResource("2")
id = &"cell_short"
display_name = "Cell Short"
base_mtbf_hours = 2600.0
wear_multiplier = 1.0
max_condition = 1.0
environmental_factors = {
"heat": 2.5,
"humidity": 1.5
}
severity = 3
symptoms = Array[StringName]([&"self_discharge", &"hot_cell"])

[resource]
script = ExtResource("1")
component_id = &"battery_main"
display_name = "Main Battery"
condition = 1.0
hours_operated = 0.0
wear_rate_per_hour = 0.0002
load = 1.0
failure_modes = Array[FailureMode]([SubResource("FailureMode_cell_fade"), SubResource("FailureMode_cell_short")])
