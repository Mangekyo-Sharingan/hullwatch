[gd_resource type="Resource" script_class="WearComponent" format=3 uid="uid://81scu1r28i18"]

[ext_resource type="Script" uid="uid://ng7r2qk1dktu" path="res://src/components/wear_component.gd" id="1"]
[ext_resource type="Script" uid="uid://ccebuvaam2wn4" path="res://src/components/failure_mode.gd" id="2"]

[sub_resource type="Resource" id="FailureMode_ballast_open"]
script = ExtResource("2")
id = &"ballast_open"
display_name = "Ballast Open"
base_mtbf_hours = 2600.0
environmental_factors = {
"humidity": 2.0
}
severity = 2
symptoms = Array[StringName]([&"dark_cabin", &"lamp_out"])

[sub_resource type="Resource" id="FailureMode_ballast_short"]
script = ExtResource("2")
id = &"ballast_short"
display_name = "Ballast Short"
base_mtbf_hours = 3400.0
environmental_factors = {
"humidity": 2.0
}
severity = 3
symptoms = Array[StringName]([&"lamp_flicker", &"load_surge"])

[resource]
resource_local_to_scene = true
script = ExtResource("1")
component_id = &"lighting_ballast"
display_name = "Lighting Ballast"
wear_rate_per_hour = 0.0002
failure_modes = Array[ExtResource("2")]([SubResource("FailureMode_ballast_open"), SubResource("FailureMode_ballast_short")])
service_circuit = &"lighting"
