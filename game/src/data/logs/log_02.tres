[gd_resource type="Resource" script_class="LogEntry" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/components/log_entry.gd" id="1_log"]

[resource]
script = ExtResource("1_log")
id = &"log_02"
date_text = "DAY 0289  -  21:40 SHIP TIME"
title = "SURVEY NOTE  -  K. VOSS"
body = "Tapped the frame today to find a rattle. There isn't one. Sixty-two metres of load-bearing structure and not a single seam, rivet or weld anywhere on the primary lattice. The yard calls it xenon-metal. The manual says grown, and then stops explaining.

I have spent eleven years around ships that were bolted together by people. This one was not. Whatever grew it had a better understanding of metal than the people who gave me this job, and they didn't think to include a chapter on it.

The terminals still boot off a 5-inch disk. That is the part I cannot square."
